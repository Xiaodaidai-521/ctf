      '\n' +
      '    <ResourceDetailModal\n' +
      '      v-if="selectedResourceId"\n' +
      '      :resourceId="selectedResourceId"\n' +
      '      :highlightResourceId="detailHighlightResourceId"\n' +
      '      @close="handleCloseModal"\n' +
      '    />\n' +
      '  </div>\n' +
      '</template>\n' +
      '\n' +
      '<script setup>\n' +
      "import { ref, computed, onMounted, watch } from 'vue'\n" +
      "import { useRoute, useRouter } from 'vue-router'\n" +
      "import { useUserStore } from '@/store/user'\n" +
      "import api from '@/api'\n" +
      "import ResourceCard from '@/components/ResourceCard.vue'\n" +
      "import ResourceDetailModal from '@/components/ResourceDetailModal.vue'\n" +
      "import ResourceSidebar from '@/components/ResourceSidebar.vue'\n" +
      'import {\n' +
      '  clearRememberedTutorResources,\n' +
      '  loadRememberedTutorResources,\n' +
      '  tutorResourceCenterIds\n' +
      "} from '@/utils/tutorResources'\n" +
      '\n' +
      'const router = useRouter()\n' +
      'const route = useRoute()\n' +
      'const userStore = useUserStore()\n' +
      '\n' +
      'const resources = ref([])\n' +
      'const loading = ref(false)\n' +
      'const currentPage = ref(1)\n' +
      'const pageSize = ref(12)\n' +
      'const total = ref(0)\n' +
      "const searchQuery = ref('')\n" +
      "const selectedType = ref('')\n" +
      "const selectedCategory = ref('')\n" +
      "const sortBy = ref('-created_at')\n" +
      'const selectedResourceId = ref(null)\n' +
      'const rememberedTutorResources = ref([])\n' +
      'const parsePositiveIds = (value) => {\n' +
      "  const rawItems = Array.isArray(value) ? value : String(value || '').split(',')\n" +
      '  return rawItems\n' +
      '    .map((item) => Number(String(item).trim()))\n' +
      '    .filter((item) => Number.isFinite(item) && item > 0)\n' +
      '}\n' +
      'const highlightResourceId = computed(() => {\n' +
      '  const value = Number(route.query.highlight_resource)\n' +
      '  return Number.isFinite(value) && value > 0 ? value : null\n' +
      '})\n' +
      '\n' +
      'const rememberedHighlightIds = computed(() => tutorResourceCenterIds(rememberedTutorResources.value))\n' +
      'const routeHighlightIds = computed(() => [\n' +
      '  ...parsePositiveIds(route.query.highlight_resource),\n' +
      '  ...parsePositiveIds(route.query.highlight_resources)\n' +
      '])\n' +
      'const currentHighlightResourceIds = computed(() => {\n' +
      '  const seen = new Set()\n' +
      '  return [...routeHighlightIds.value, ...rememberedHighlightIds.value].filter((id) => {\n' +
      '    if (seen.has(id)) return false\n' +
      '    seen.add(id)\n' +
      '    return true\n' +
      '  })\n' +
      '})\n' +
      'const hasAISurfacedResources = computed(() => currentHighlightResourceIds.value.length > 0)\n' +
      'const detailHighlightResourceId = computed(() => {\n' +
      '  const selectedId = Number(selectedResourceId.value)\n' +
      '  if (Number.isFinite(selectedId) && currentHighlightResourceIds.value.includes(selectedId)) return selectedId\n' +
      '  return highlightResourceId.value\n' +
      '})\n' +
      '\n' +
      'const refreshRememberedTutorResources = () => {\n' +
      '  rememberedTutorResources.value = loadRememberedTutorResources()\n' +
      '}\n' +
      '\n' +
      'const isTeacherOrAdmin = computed(() => {\n' +
      '  const role = userStore.userInfo?.role\n' +
      "  return role === 'teacher' || role === 'admin'\n" +
      '})\n' +
      '\n' +
      'const totalPages = computed(() => Math.ceil(total.value / pageSize.value))\n' +
      '\n' +
      'const fetchResources = async () => {\n' +
      '  loading.value = true\n' +
      '  try {\n' +
      '    const params = {\n' +
      '      page: currentPage.value,\n' +
      '      page_size: pageSize.value,\n' +
      '      ordering: sortBy.value,\n' +
      '    }\n' +
      '    if (searchQuery.value) params.search = searchQuery.value\n' +
      '    if (selectedType.value) params.resource_type = selectedType.value\n' +
      '    if (selectedCategory.value) params.category = selectedCategory.value\n' +
      '    if (highlightResourceId.value) params.highlight_resource = highlightResourceId.value\n' +
      "    if (currentHighlightResourceIds.value.length) params.highlight_resources = currentHighlightResourceIds.value.join(',')\n" +
      '\n' +
      '    const data = await api.resource.list(params)\n' +
      '    resources.value = data.results || []\n' +
      '    total.value = data.count || 0\n' +
      '  } catch (error) {\n' +
      "    console.error('获取资源列表失败:', error)\n" +
      '    resources.value = []\n' +
      '  } finally {\n' +
      '    loading.value = false\n' +
      '  }\n' +
      '}\n' +
      '\n' +
      'const handleSearch = debounce(() => {\n' +
      '  currentPage.value = 1\n' +
      '  fetchResources()\n' +
      '}, 500)\n' +
      '\n' +
      'const handleFilter = () => {\n' +
      '  currentPage.value = 1\n' +
      '  fetchResources()\n' +
      '}\n' +
      '\n' +
      'const handlePageChange = (page) => {\n' +
      '  currentPage.value = page\n' +
      '  fetchResources()\n' +
      "  window.scrollTo({ top: 0, behavior: 'smooth' })\n" +
      '}\n' +
      '\n' +
      'const focusResourceList = (selection = {}) => {\n' +
      '  if (selection.category) {\n' +
      '    selectedCategory.value = selection.category\n' +
      '    currentPage.value = 1\n' +
      '    fetchResources()\n' +
      '  }\n' +
      "  document.querySelector('.filters-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' })\n" +
      '}\n' +
      '\n' +
      'const handleResourceClick = (resource) => {\n' +
      '  selectedResourceId.value = resource.id\n' +
      '}\n' +
      '\n' +
      'const handleCloseModal = () => {\n' +
      '  selectedResourceId.value = null\n' +
      '  if (route.query.resource) {\n' +
      '    const query = { ...route.query }\n' +
      '    delete query.resource\n' +
      "    router.replace({ path: '/resources', query })\n" +
      '  }\n' +
      '  fetchResources()\n' +
      '}\n' +
      '\n' +
