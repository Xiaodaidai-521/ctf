            <h3 class="path-title">{{ path.title }}</h3>
            <p class="path-description">{{ path.description }}</p>
    
            <div class="path-meta">
              <div class="meta-item">
                <i class="bi bi-layers"></i>
                <span>{{ path.module_count || 0 }} 章节</span>
              </div>
