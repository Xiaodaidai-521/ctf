      padding: 42px 24px 72px;
      max-width: 1180px;
      margin: 0 auto;
      background:
        linear-gradient(90deg, rgba(24, 23, 19, 0.045) 1px, transparent 1px) 0 0 / 44px 44px,
        linear-gradient(180deg, #faf7f0 0%, var(--bg-paper) 100%);
      min-height: 100vh;
    }
    
