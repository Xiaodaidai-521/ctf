      '      </button>\n' +
      '      <span class="page-info">{{ currentPage }} / {{ totalPages }}</span>\n' +
      '      <button\n' +
      '        class="page-btn"\n' +
      '        :disabled="currentPage === totalPages"\n' +
      '        @click="handlePageChange(currentPage + 1)"\n' +
