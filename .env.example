# CTF平台环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ========================================
# Django配置
# ========================================

# 调试模式（生产环境设为False）
DEBUG=False

# 允许的主机（生产环境必须修改）
ALLOWED_HOSTS=你的域名或IP
ALLOWED_ORIGINS=http://你的域名或IP
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Django密钥（生产环境必须修改为随机字符串）
# 可以使用以下命令生成随机密钥：
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key-in-production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# 数据库配置
DB_PASSWORD=change-this-database-password
DATABASE_URL=sqlite:///db.sqlite3

# 时区
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans

# ========================================
# FRP配置
# ========================================

# FRP API地址
FRP_API_URL=http://frp-server:7500

# FRP HTTP域名
FRP_HTTP_DOMAIN=你的域名或IP

# FRP HTTP端口
FRP_HTTP_PORT=9123

# ========================================
# 容器配置
# ========================================

# 容器端口池范围
CONTAINER_PORT_MIN=8000
CONTAINER_PORT_MAX=9000

# 容器启动超时时间（秒）
CONTAINER_STARTUP_TIMEOUT=120

# 容器自动清理时间（秒，0表示不自动清理）
CONTAINER_AUTO_CLEANUP=3600

# ========================================
# Coze AI配置（可选）
# ========================================

# Coze API密钥（如果使用AI助手）
COZE_API_KEY=your-coze-api-key

# Coze Bot ID
COZE_BOT_ID=your-coze-bot-id

# ========================================
# 邮件配置（可选）
# ========================================

# SMTP服务器
EMAIL_HOST=smtp.gmail.com

# SMTP端口
EMAIL_PORT=587

# 邮件发送者
EMAIL_HOST_USER=your-email@gmail.com

# 邮件密码
EMAIL_HOST_PASSWORD=your-email-password

# 邮件发送者名称
EMAIL_FROM=CTF Platform <noreply@ctf.local>

# ========================================
# Redis配置（可选）
# ========================================

# Redis地址
REDIS_URL=redis://:your-redis-password@redis:6379/0

# ========================================
# 日志配置
# ========================================

# 日志级别
LOG_LEVEL=INFO

# 日志保留天数
LOG_RETENTION_DAYS=30

# ========================================
# 安全配置
# ========================================

# Session过期时间（秒）
SESSION_COOKIE_AGE=86400

# CSRF Cookie安全设置
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# ========================================
# 上传配置
# ========================================

# 最大文件上传大小（MB）
MAX_UPLOAD_SIZE=50

# 允许的文件类型
ALLOWED_FILE_TYPES=pdf,zip,tar,gz,jpg,png,gif,txt,md

# ========================================
# 性能配置
# ========================================

# 每页显示数量
PAGE_SIZE=20

# 缓存超时时间（秒）
CACHE_TIMEOUT=3600

# ========================================
# 功能开关
# ========================================

# 是否启用AI助手
ENABLE_AI_ASSISTANT=true

# ========================================
# AI 密钥配置
# ========================================
# 不要把真实密钥写进代码或提交到仓库，只在 .env 中填写。
AI_API_SECRET=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
WENXIN_API_KEY=
WENXIN_AK=
WENXIN_SK=
WENXIN_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat
WENXIN_MODEL=ernie-bot-4
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_SECRET=
SPARK_BASE_URL=wss://spark-api.xf-yun.com/v3.5/chat
SPARK_MODEL=generalv3.5

# 是否启用容器题目
ENABLE_CONTAINER_CHALLENGES=true

# 是否启用注册
ENABLE_REGISTRATION=true

# 是否启用社区文章
ENABLE_ARTICLES=true

# 是否启用学习路径
ENABLE_LEARNING_PATHS=true
