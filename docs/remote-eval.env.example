# Copy this file outside the repository and fill in credentials locally.
# Qwen embedding was retired by user decision on 2026-11-14.
# EMBEDDING_PROVIDER=qwen
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSION=1024
# EMBEDDING_API_KEY=
# Ark text embeddings use the approved multimodal endpoint at 1024 dimensions.
EMBEDDING_PROVIDER=volcano
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_BATCH_SIZE=1
EMBEDDING_API_KEY=REPLACE_WITH_ARK_EMBEDDING_API_KEY
LEGAL_KB_RAG_AGENT_ID=legal_reviewer

# Confirm this chat model is available in your DeepSeek account.
DEEPSEEK_MODEL=REPLACE_WITH_AVAILABLE_DEEPSEEK_CHAT_MODEL_ID
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY

# Optional: only add these when you also want a Volcano chat probe.
# ARK_MODEL=REPLACE_WITH_AVAILABLE_ARK_CHAT_MODEL_ID
# ARK_API_KEY=REPLACE_WITH_ARK_API_KEY
