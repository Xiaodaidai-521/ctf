[
  {
    "name": "AssetVersionRef",
    "owner": "既有资产所有者（待跨线指定；主线一只适配，不另建资产系统）",
    "consumers": [
      "主线一受控 AssetReader",
      "主线二",
      "执行支线"
    ],
    "fields": [
      {
        "name": "meta",
        "type": "#/$defs/Meta",
        "required": true,
        "nullable": false,
        "meaning": "可信公共上下文"
      },
      {
        "name": "asset",
        "type": "#/$defs/AssetKey",
        "required": true,
        "nullable": false,
        "meaning": "固定版本与原始字节摘要"
      },
      {
        "name": "owner_service",
        "type": "string",
        "required": true,
        "nullable": false,
        "meaning": "资产对象所有者服务，草案候选 asset_registry"
      },
      {
        "name": "format",
        "type": "[\"csv\", \"xlsx\"]",
        "required": true,
        "nullable": false,
        "meaning": "仅支持首版格式"
      },
      {
        "name": "private_storage_ref",
        "type": "string",
        "required": true,
        "nullable": false,
        "meaning": "不透明私有句柄；不可用作路径/URL/下载授权"
      },
      {
        "name": "byte_size",
        "type": "integer",
        "required": true,
        "nullable": false,
        "meaning": "固定原始字节数"
      },
      {
        "name": "state",
        "type": "[\"ready\", \"deleted\", \"unavailable\"]",
        "required": true,
        "nullable": false,
        "meaning": "来自对象所有者的当前状态观察"
      },
      {
        "name": "state_version",
        "type": "integer",
        "required": true,
        "nullable": false,
        "meaning": "状态观察版本；内容引用不变"
      },
      {
        "name": "deleted_at",
        "type": "[{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]",
        "required": true,
        "nullable": true,
        "meaning": "删除时保留最小墓碑时间"
      }
    ],
    "invariants": [
      "asset 字节和版本不可变；state 是独立权威观察，state_version 单调",
      "deleted 必须 deleted_at；private_storage_ref 不是访问授权"
    ],
    "errors": [
      "AUTHENTICATION_REQUIRED",
      "OBJECT_NOT_FOUND",
      "DOMAIN_MISMATCH",
      "ASSET_DELETED",
      "ASSET_VERSION_MISMATCH"
    ],
    "compatibility": "新增独立 namespace；不改变资源/RAG/agent-runtime 既有返回；跨线类型映射需共同确认",
    "approval_status": "proposed"
  },
