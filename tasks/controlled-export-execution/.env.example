CONTROLLED_EXPORT_DEBUG=false
CONTROLLED_EXPORT_ENVIRONMENT=evaluation
CONTROLLED_EXPORT_ALLOWED_HOSTS=localhost,127.0.0.1
CONTROLLED_EXPORT_DJANGO_SECRET=replace-with-a-random-secret
CONTROLLED_EXPORT_INTERNAL_KEY=replace-with-a-service-credential
EXECUTION_AUTHORITY_HMAC_SECRET=replace-with-an-authority-signing-secret
SHARE_TOKEN_PEPPER=replace-with-an-independent-random-pepper

# Use an isolated PostgreSQL database for production-like lock verification.
# CONTROLLED_EXPORT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/controlled_export

# All storage remains below this private, non-web-served root.
# CONTROLLED_EXPORT_PRIVATE_ROOT=/srv/controlled-export/private
